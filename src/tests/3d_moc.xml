<case_name>3D_MoC_Test</case_name>

<solver type="eigenvalue" k_tol="1.e-6" psi_tol="1.e-5" max_iter="5">
    <source scattering="P0" />
    <sweeper type="moc" n_inner="5">
        <ang_quad type="ls" order="4" />
        <rays spacing="0.05" modularity="core" />
    </sweeper>
</solver>

<material_lib path="c5g7.xsl">
    <material id="1" name="UO2-3.3" />
    <material id="2" name="MOX-4.3" />
    <material id="6" name="Moderator" />
</material_lib>

<mesh id="1" type="cyl" pitch="1.26">
    <radii>0.54 0.62</radii>
    <sub_radii>5 2</sub_radii>
    <sub_azi>8</sub_azi>
</mesh>

<mesh id="2" type="rect" pitch="1.26">
    <sub_x>5</sub_x>
    <sub_y>5</sub_y>
</mesh>

<pin id="1" mesh="1">
    1 6 6
</pin>
<pin id="2" mesh="1">
    2 6 6
</pin>
<pin id="3" mesh="2">
    6 6 6 6 6
    6 6 6 6 6
    6 6 6 6 6
    6 6 6 6 6
    6 6 6 6 6
</pin>

<lattice id="1" nx="3" ny="3">
    1 2 1
    1 1 1
    1 2 2
</lattice>

<lattice id="2" nx="3" ny="3">
    3 3 3
    3 3 3
    3 3 3
</lattice>

<assembly id="1" np="3" hz="0.5">
    <lattices>
        1 1 1
    </lattices>
</assembly>
<assembly id="2" np="3" hz="0.5">
    <lattices>
        2 2 2
    </lattices>
</assembly>

<core nx="2" ny="1"
    north  = "reflect"
    south  = "vacuum"
    east   = "vacuum"
    west   = "reflect"
    top    = "reflect"
    bottom = "vacuum" >
    1 2
</core>
